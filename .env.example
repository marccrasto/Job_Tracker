# Copy this file to .env for local development: cp .env.example .env
# .env is gitignored. Never commit real passwords.

PORT=3000

# Local: Postgres running in Docker on your machine
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobtracker
DB_SSL=false

# Production (RDS): same variable names, different values, e.g.
# DB_HOST=job-tracker-db.xxxxxxxx.ca-central-1.rds.amazonaws.com
# DB_SSL=true


# Logger Config
LOG_LEVEL=info
APP_ENV=local