{
  "name": "job-tracker",
  "version": "1.0.0",
  "description": "Job application tracker: Node/Express API, PostgreSQL (RDS), vanilla JS frontend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env src/scripts/initDb.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
